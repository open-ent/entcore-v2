# Registre public npm
registry=https://registry.npmjs.org/
@edifice-tiptap-extensions:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Registre Tiptap Pro
@tiptap-pro:registry=https://registry.tiptap.dev/
//registry.tiptap.dev/:_authToken=${TIPTAP_PRO_TOKEN}

# GitHub Packages pour les paquets @open-ent
@open-ent:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Registry Nexus Open-ENT
@openent:registry=https://rct-nexus.tech.fr/repository/npm-passtech/
@passtech:registry=https://rct-nexus.tech.fr/repository/npm-passtech/
//rct-nexus.tech.fr/repository/npm-passtech/:_authToken=${NEXUS_TOKEN}

# Comportement pnpm
auto-install-peers=true
confirm-modules-purge=false