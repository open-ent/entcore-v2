<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.openent</groupId>
        <artifactId>app-parent</artifactId>
        <version>1.2.1</version>
    </parent>

    <groupId>org.entcore</groupId>
    <artifactId>ent-core</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <repositories>
        <repository>
            <id>m2</id>
            <name>m2 Repository</name>
            <url>https://plugins.gradle.org/m2/</url>
        </repository>
    </repositories>

    <scm>
        <connection>scm:git:https://github.com/opendigitaleducation/entcore.git</connection>
        <developerConnection>scm:git:https://github.com/opendigitaleducation/entcore.git</developerConnection>
        <url>https://github.com/opendigitaleducation/entcore</url>
    </scm>

    <modules>
        <module>libs</module>
        <module>admin</module>
        <module>app-registry</module>
        <module>archive</module>
        <module>audience</module>
        <module>auth</module>
        <module>cas</module>
        <module>communication</module>
        <module>conversation/backend</module>
        <module>directory</module>
        <module>feeder</module>
        <module>infra</module>
        <module>interoperability</module>
        <module>portal/backend</module>
        <module>timeline</module>
        <module>workspace</module>
        <module>tests</module>
    </modules>

    <properties>
        <revision>6.16.14-patched</revision>
        <!-- Bibliothèques partagées (common, session, broker-*…), réintégrées dans libs/ : elles
             se versionnent avec le socle. La propriété reste pour les poms des modules du socle. -->
        <entCoreLibsVersion>${revision}</entCoreLibsVersion>
        <!--
          Bibliothèque d'interopérabilité des cours (open-ent/interoperability) : lecture et
          écriture de SCORM 1.2/2004, cmi5, xAPI, QTI 3.0, Common Cartridge 1.3, des sauvegardes
          Moodle, des banques Moodle XML et des exports LearnHouse. Elle ne
          dépend ni de Vert.x ni d'entcore, et cible le bytecode Java 8 comme le reste.
        -->
        <openentInteroperabilityVersion>1.5.0</openentInteroperabilityVersion>
        <junitVersion>4.13.2</junitVersion>
        <testContainerVersion>1.19.3</testContainerVersion>
        <modPostgresVersion>2.2.1</modPostgresVersion>
        <modMongoVersion>4.2.0</modMongoVersion>
        <modSmsProxyVersion>2.2.0</modSmsProxyVersion>
        <webUtilsVersion>3.4.4</webUtilsVersion>
        <imageResizerVersion>3.3.1</imageResizerVersion>
        <mongodbHelperVersion>3.1.1</mongodbHelperVersion>
        <jodaTimeVersion>2.9.4</jodaTimeVersion>
        <scramVersion>2.1</scramVersion>
        <micrometerPrometheusVersion>1.11.4</micrometerPrometheusVersion>
        <owaspVersion>20220608.1</owaspVersion>
        <jacksonVersion>2.18.11</jacksonVersion>
        <casVersion>0.3.1</casVersion>
        <vertxCronTimerVersion>3.0.0</vertxCronTimerVersion>
        <opencsvVersion>3.9</opencsvVersion>
        <juniversalchardetVersion>1.0.3</juniversalchardetVersion>
        <commonsLangVersion>3.13.0</commonsLangVersion>
        <gatlingHighchartsVersion>2.3.1</gatlingHighchartsVersion>
        <postgres-driver.version>42.2.26</postgres-driver.version>
        <hikari.version>2.4.2</hikari.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.entcore</groupId>
            <artifactId>common</artifactId>
            <version>${entCoreLibsVersion}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.entcore</groupId>
            <artifactId>session</artifactId>
            <version>${entCoreLibsVersion}</version>
            <scope>runtime</scope>
            <classifier>fat</classifier>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jacksonVersion}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
            <version>${vertxVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-unit</artifactId>
            <version>${vertxVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junitVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testContainerVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <version>${testContainerVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testContainerVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>elasticsearch</artifactId>
            <version>${testContainerVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <version>${testContainerVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>fr.wseduc</groupId>
            <artifactId>mod-postgresql</artifactId>
            <version>${modPostgresVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres-driver.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>mod-mongo-persistor</artifactId>
            <version>${modMongoVersion}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mongodb</groupId>
                    <artifactId>mongodb-driver-async</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Used by future Image creation
        <dependency>
            <groupId>com.opendigitaleducation</groupId>
            <artifactId>mod-json-schema-validator</artifactId>
            <version>2.1.0</version>
            <scope>runtime</scope>
            <classifier>fat</classifier>
        </dependency>
        <dependency>
            <groupId>fr.wseduc</groupId>
            <artifactId>mod-image-resizer</artifactId>
            <version>3.2.0</version>
            <scope>runtime</scope>
            <classifier>fat</classifier>
        </dependency>
        <dependency>
            <groupId>fr.wseduc</groupId>
            <artifactId>mod-zip</artifactId>
            <version>3.2.0</version>
            <scope>runtime</scope>
            <classifier>fat</classifier>
        </dependency>
        <dependency>
            <groupId>fr.wseduc</groupId>
            <artifactId>mod-pdf-generator</artifactId>
            <version>2.1.0</version>
            <scope>runtime</scope>
            <classifier>fat</classifier>
        </dependency>-->
    </dependencies>

    <build>
        <plugins>
            <!-- Depuis le JDK 23, javac n'exécute plus les processeurs d'annotations trouvés sur le
                 classpath : sans `-proc:full`, le build reste vert mais les jars partent sans
                 securedaction/, routes/ ni swagger/ (404 sur chaque route sécurisée). Posé ici, au
                 niveau du réacteur, il vaut pour tous les sous-modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin> <!-- Plugin enabling parent pom version to be resolved when building any submodule alone -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.scala-tools</groupId>
                <artifactId>maven-scala-plugin</artifactId>
                <version>2.15.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <jvmArgs>
                                <jvmArg>-Xss4m</jvmArg>
                                <jvmArg>-Xms512m</jvmArg>
                                <jvmArg>-Xmx4096m</jvmArg>
                            </jvmArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
