{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "functionCode": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inherit" : {
      "type": "string"
    },
    "validUntil" : {
      "type": "integer",
      "minimum": 0
    },
    "reason" : {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "functionCode"
  ]
}