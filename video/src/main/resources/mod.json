{
	"main": "org.entcore.video.Video",
	"auto-redeploy": false,
	"port": 8019,
	"mode": "dev",
	"app-name": "Vidéo",
	"app-address": "http://localhost:8019/video/video",
	"app-icon": "video-large",
	"app-displayName": "video",
	"mongo-address": "wse.mongodb.persistor",
	"gridfs-address": "wse.gridfs.persistor",

	"publicConf": {
		"max-videosize-mbytes": 50,
		"max-videoduration-minutes": 3,
		"accept-videoupload-extensions": ["mp4", "mov", "avi"]
	},

	"ffmpeg-path": "/usr/bin/ffmpeg",
	"encode-timeout-ms": 300000
}
